# .envrc
export AP_PNC_DIR=$(dirname $(readlink -f "${BASH_SOURCE[0]}"))
export ACADOS_SOURCE_DIR="$AP_PNC_DIR/mpc_framework"
export PX4_ROOT="$AP_PNC_DIR/px4_vtol"
export NMPC_DIR="$AP_PNC_DIR/src/nmpc"
export PYTHONPATH="$PYTHONPATH:$NMPC_DIR"
export LD_LIBRARY_PATH=$AP_PNC_DIR/c_generated_code:$LD_LIBRARY_PATH:"$ACADOS_SOURCE_DIR/lib"
export PATH=$PATH:$AP_PNC_DIR/scripts/tools

# Source ROS 2 Workspace Setup
if [ -f "install/setup.bash" ]; then
    source "install/setup.bash"
fi
