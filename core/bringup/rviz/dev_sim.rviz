Panels:
  - Class: rviz_common/Displays
  - Class: rviz_common/Views
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: world
    Background Color: 242; 244; 245
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground grid
      Enabled: true
      Plane Cell Count: 50
    - Class: rviz_default_plugins/PointCloud2
      Name: Scene map
      Enabled: true
      Topic:
        Value: /lidar_sim/map
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Size (m): 0.06
      Color Transformer: FlatColor
      Color: 120; 130; 145
    - Class: rviz_default_plugins/PointCloud2
      Name: LiDAR first returns
      Enabled: true
      Topic:
        Value: /lidar_sim/points
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Size (m): 0.09
      Decay Time: 0.5
      Color Transformer: AxisColor
      Axis: Z
    - Class: rviz_default_plugins/Path
      Name: Planner reference
      Enabled: true
      Topic:
        Value: /simple_sim/reference
        Durability Policy: Transient Local
      Color: 255; 180; 40
    - Class: rviz_default_plugins/Path
      Name: Actual plant path
      Enabled: true
      Topic:
        Value: /simple_sim/path
      Color: 49; 93; 147
    - Class: rviz_default_plugins/TF
      Name: Frames
      Enabled: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 35
      Pitch: 0.7
      Yaw: 0.6
Window Geometry:
  Width: 1200
  Height: 850
