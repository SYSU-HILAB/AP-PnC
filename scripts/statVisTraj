#!/usr/bin/python3

import pandas as pd
import matplotlib.pyplot as plt
import numpy as np

def calculate_distance(ref_x, ref_y, x, y):
    return np.sqrt((ref_x - x)**2 + (ref_y - y)**2)

# Read the CSV file
df = pd.read_csv('output.csv', delimiter=';')

# Convert necessary columns to numpy arrays
ref_px = df['ref_px'].values 
ref_py = df['ref_py'].values 
px = df['px'].values
py = df['py'].values
time = df['time'].values
ref_pz = df['ref_pz'].values - 0.4
pz = df['pz'].values

# Plot Horizontal view: Ref_xy vs xy
plt.figure(figsize=(10, 6))

# Plotting ref_px vs ref_py and px vs py
plt.plot(ref_px, ref_py, label='Ref_xy', color='green')
# hold on 

plt.plot(px, py, label='xy', color='red')
plt.xlabel('X Position')
plt.ylabel('Y Position')
plt.title('Horizontal view: Ref_xy vs xy')
plt.legend()
plt.grid(True)
plt.xlim([-40, 0])
plt.ylim([-20, 20])
plt.show()

# Plot Vertical view: Ref_z vs z
plt.figure(figsize=(10, 6))

# Plotting ref_pz vs time and pz vs time
plt.plot(time, ref_pz, label='Ref_z', color='blue')
plt.plot(time, pz, label='z', color='red')

plt.xlabel('Time')
plt.ylabel('Z Position')
plt.title('Vertical view: Ref_z vs z')
plt.legend()
plt.grid(True)
plt.ylim([-5, 5])
plt.show()
print(ref_px-px)

# Calculate the distance between the reference and the actual position
print(f'Batch RMSE: {np.sqrt(np.mean((calculate_distance(ref_px, ref_py, px, py))**2))}')