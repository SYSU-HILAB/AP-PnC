#!/usr/bin/python3

import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import argparse

def calculate_distance(ref_x, ref_y, x, y):
    return np.sqrt((ref_x - x)**2 + (ref_y - y)**2)

parser = argparse.ArgumentParser(description='Data recording script.')

parser.add_argument('-f', type=str, required=True, help='Name of the output CSV file')

args = parser.parse_args()

csv_file_name = args.f 

# Read the CSV file
df = pd.read_csv(f'{csv_file_name}.csv', delimiter=';')

# Convert necessary columns to numpy arrays
ref_px = df['ref_px'].values 
ref_py = df['ref_py'].values 
px = df['px'].values
py = df['py'].values
time = df['time'].values
ref_pz = df['ref_pz'].values - 0.4
pz = df['pz'].values

vx = df['vx'].values
vy = df['vy'].values
vz = df['vz'].values
ref_vx = df['ref_vx'].values
ref_vy = df['ref_vy'].values
ref_vz = df['ref_vz'].values
omg_x = df['omg_x'].values
omg_y = df['omg_y'].values
omg_z = df['omg_z'].values
ref_omg_x = df['ref_omg_x'].values
ref_omg_y = df['ref_omg_y'].values
ref_omg_z = df['ref_omg_z'].values
acc_z = df['acc_z'].values
ref_acc_z = df['ref_acc_z'].values

# 创建包含四个子图的图形
fig, axs = plt.subplots(2, 2, figsize=(14, 10))

# 第一个子图：Horizontal view: Ref_xy vs xy
axs[0, 0].plot(ref_px, ref_py, label='Ref_xy', color='green')
axs[0, 0].plot(px, py, label='xy', color='red')
axs[0, 0].set_xlabel('X Position')
axs[0, 0].set_ylabel('Y Position')
axs[0, 0].set_title('Horizontal view: Ref_xy vs xy')
axs[0, 0].legend()
axs[0, 0].grid(True)
axs[0, 0].set_xlim([-40, 0])
axs[0, 0].set_ylim([-20, 20])

# 第二个子图：Vertical view: Ref_z vs z
axs[0, 1].plot(time, ref_pz, label='Ref_z', color='blue')
axs[0, 1].plot(time, pz, label='z', color='red')
axs[0, 1].set_xlabel('Time')
axs[0, 1].set_ylabel('Z Position')
axs[0, 1].set_title('Vertical view: Ref_z vs z')
axs[0, 1].legend()
axs[0, 1].grid(True)
axs[0, 1].set_ylim([-5, 5])

# 第三个子图：Velocity Norm: Ref_v_norm vs v_norm
v_norm = np.sqrt(vx**2 + vy**2 + vz**2)
ref_v_norm = np.sqrt(ref_vx**2 + ref_vy**2 + ref_vz**2)
axs[1, 0].plot(time, ref_v_norm, label='Ref_v_norm', color='blue')
axs[1, 0].plot(time, v_norm, label='v_norm', color='red')
axs[1, 0].set_xlabel('Time')
axs[1, 0].set_ylabel('Velocity Norm')
axs[1, 0].set_title('Velocity Norm: Ref_v_norm vs v_norm')
axs[1, 0].legend()
axs[1, 0].grid(True)

# 第四个子图：omg vs ref_omg
axs[1, 1].plot(time, ref_omg_x, label='Ref_omg_x', color='blue')
axs[1, 1].plot(time, omg_x, label='omg_x', color='red')
axs[1, 1].plot(time, ref_omg_y, label='Ref_omg_y', color='green')
axs[1, 1].plot(time, omg_y, label='omg_y', color='red')
axs[1, 1].plot(time, ref_omg_z, label='Ref_omg_z', color='orange')
axs[1, 1].plot(time, omg_z, label='omg_z', color='red')
axs[1, 1].set_xlabel('Time')
axs[1, 1].set_ylabel('Angular Velocity vs Ref Angular Velocity')
axs[1, 1].set_title('Angular Velocity: omg vs ref_omg')
axs[1, 1].legend()
axs[1, 1].grid(True)

# 调整子图布局
plt.tight_layout()
plt.show()

# 打印 RMSE
print(f'Batch RMSE: {np.sqrt(np.mean((calculate_distance(ref_px, ref_py, px, py))**2))}')
# 打印最大 RMSE
print(f'Batch Max RMSE: {np.max(calculate_distance(ref_px, ref_py, px, py))}')
