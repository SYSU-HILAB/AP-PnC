#!/usr/bin/python3
import rclpy
from rclpy.node import Node
from std_msgs.msg import Float64
import matplotlib.pyplot as plt

class PositionSimulator(Node):
    def __init__(self):
        super().__init__('position_simulator')
        self.subscription = self.create_subscription(
            Float64,
            'acceleration',
            self.listener_callback,
            10)
        self.subscription  # prevent unused variable warning
        self.acceleration = 0.0
        self.velocity = 0.0
        self.position = 0.0
        self.count = 0
        self.positions = []
        self.velocities = []
        self.times = []
        self.accelerations = []
    
    def listener_callback(self, msg):
        dt = 0.02
        self.count = self.count + 1
        self.acceleration = msg.data

        # RK4 integration
        k1_v = self.acceleration * dt
        k1_x = self.velocity * dt

        k2_v = (self.acceleration) * dt
        k2_x = (self.velocity + 0.5 * k1_v) * dt

        k3_v = (self.acceleration) * dt
        k3_x = (self.velocity + 0.5 * k2_v) * dt

        k4_v = (self.acceleration) * dt
        k4_x = (self.velocity + k3_v) * dt

        self.velocity += (k1_v + 2*k2_v + 2*k3_v + k4_v) / 6
        self.position += (k1_x + 2*k2_x + 2*k3_x + k4_x) / 6

        self.positions.append(self.position)
        self.velocities.append(self.velocity)
        self.accelerations.append(self.acceleration)
        current_time = self.count * dt
        self.times.append(current_time)
        self.get_logger().info(f'Position: {self.position}, Velocity: {self.velocity}')

    def plot_results(self):
        fig, ax1 = plt.subplots()

        ax1.set_xlabel('Time [s]')
        ax1.set_ylabel('Position [m]', color='tab:blue')
        ax1.plot(self.times, self.positions, color='tab:blue', label='Position')
        ax1.tick_params(axis='y', labelcolor='tab:blue')

        ax2 = ax1.twinx()
        ax2.set_ylabel('Velocity [m/s]', color='tab:orange')
        ax2.plot(self.times, self.velocities, color='tab:orange', label='Velocity')
        ax2.tick_params(axis='y', labelcolor='tab:orange')

        fig.tight_layout()
        plt.title('Position and Velocity vs Time')

        # Plot acceleration
        fig2, ax3 = plt.subplots()
        ax3.set_xlabel('Time [s]')
        ax3.set_ylabel('Acceleration [m/s^2]', color='tab:green')
        ax3.plot(self.times, self.accelerations, color='tab:green', label='Acceleration')
        ax3.tick_params(axis='y', labelcolor='tab:green')
        plt.title('Acceleration vs Time')

        plt.show()

def main(args=None):
    rclpy.init(args=args)
    node = PositionSimulator()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.plot_results()
        node.destroy_node()
        rclpy.shutdown()

if __name__ == '__main__':
    main()