#!/bin/bash
kr

PIDS=$(pgrep -f "gz sim")
if [ -n "$PIDS" ]; then
  echo $PIDS | xargs kill
fi

PIDS=$(pgrep -f "micro-xrce-dds")
if [ -n "$PIDS" ]; then
  echo $PIDS | xargs kill
fi

if [ -z "$1" ]; then
    echo "No GUI Required, HEADLESS=1."
    HEADLESSVal=1
else
    HEADLESSVal=0
fi

cd $PX4_ROOT

# start px4_interface
ros2 launch px4_interface px4_interface.launch.py frame:=NED&
# ros2 run px4_interface fixed_ref &
# start communication 
MicroXRCEAgent udp4 -p 8888 &

# Start the PX4 SITL
if [ $HEADLESSVal -eq 1 ]; then
    echo "Running PX4 SITL in headless mode."
    HEADLESS=1 make px4_sitl gz_tailsitter
else
    echo "Running PX4 SITL with GUI."
    make px4_sitl gz_x500
fi

