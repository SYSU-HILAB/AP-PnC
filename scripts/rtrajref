#!/bin/bash
source install/setup.bash

# if there is no arguments, run the default launch file
# if there exist any argument run 
# get if there is any argument  encapsulate it as a function
function if_any_argument(){
    if [ -z "$1" ]
    then
        echo "No argument supplied"
    else
        echo "Argument supplied"
    fi
}


ros2 launch px4_interface planning.launch.py &


ros2 launch px4_interface planning.launch.py tgt_quat:=[1.0,0.0,0.0,1.0] &