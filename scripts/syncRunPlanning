#!/usr/bin/python3
import os
import yaml
from ament_index_python.packages import get_package_share_directory
import argparse

import subprocess

def launch_px4_interface(height, quat):
    try:
        process = subprocess.Popen(
            ['ros2', 'launch', 'px4_interface', 'planning.launch.py'],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            bufsize=1,
            universal_newlines=True
        )
        
        while True:
            output = process.stdout.readline()
            if output == '' and process.poll() is not None:
                break
            if output:
                print(output.strip())
        
        rc = process.poll()
        if rc == 0:
            print("Launch successful!")
        else:
            print(f"Launch failed with return code {rc}")
    except Exception as e:
        print(f"Error occurred: {str(e)}")

def main():
    parser = argparse.ArgumentParser(description='Sync Planning Script')
    parser.add_argument('--mode', action='store_true', help='trigger, specify the init quaternion')
    args = parser.parse_args()
    if args.mode:
        quat=[1.0, 0.0, 0.0, 0.0]
    else:
        quat=[0.707, 0.0, 0.0, 0.707]

    rsl, height = get_planning_config()
    print(f'Quaternion is {quat}')
    print(f'Height is {height}')
    launch_px4_interface(height, quat)


def get_planning_config():
    package_name = 'trajectory_server'
    config_file_name = 'global_planning.yaml'
    config_file_path = os.path.join(get_package_share_directory(package_name), 'config', config_file_name)

    # Load the YAML file
    with open(config_file_path, 'r') as file:
        config = yaml.safe_load(file)
        node_config = config['/global_planning_node']['ros__parameters']

        traj_pub_rsl = node_config['traj_pub_rsl']
        basic_trajectory_height = node_config['BasicTrajectoryHeight']

    return traj_pub_rsl, basic_trajectory_height


if __name__ == "__main__":
    main()