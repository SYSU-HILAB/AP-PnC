#!/usr/bin/python3
import rclpy
from rclpy.node import Node
from px4_msgs.msg import VehicleThrustAccSetpoint  # Replace with your package name
import time

class ThrustPublisher(Node):

    def __init__(self):
        super().__init__('thrust_publisher')
        self.publisher_ = self.create_publisher(VehicleThrustAccSetpoint, '/fmu/in/vehicle_thrust_acc_setpoint', 10)
        timer_period = 0.02  # 50Hz
        self.timer = self.create_timer(timer_period, self.timer_callback)
        self.initialized = False
        
    def timer_callback(self):
        msg = VehicleThrustAccSetpoint()
        msg.timestamp = int(self.get_clock().now().nanoseconds)  # Convert current time to microseconds
        msg.thrust_acc_sp = 15.0  # Example value
        msg.rates_sp = [0.0, 0.0, 0.0]  # Example values
        self.publisher_.publish(msg)
        # print when init
        if self.initialized == False:
            self.get_logger().info('Thrust Publisher Initialized')
            self.get_logger().info(f'VehicleThrustAccSetpoint {msg.thrust_acc_sp}')
            self.initialized = True

def main(args=None):
    rclpy.init(args=args)
    thrust_publisher = ThrustPublisher()
    rclpy.spin(thrust_publisher)
    thrust_publisher.destroy_node()
    rclpy.shutdown()

if __name__ == '__main__':
    main()
