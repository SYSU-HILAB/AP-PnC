#!/bin/bash
PIDS=$(pgrep -f "px4")
if [ -n "$PIDS" ]; then
  echo $PIDS | xargs kill
fi

PIDS=$(pgrep -f "gz")
if [ -n "$PIDS" ]; then
  echo $PIDS | xargs kill
fi

PIDS=$(pgrep -f "micro-xrce-dds")
if [ -n "$PIDS" ]; then
  echo $PIDS | xargs kill
fi

PIDS=$(pgrep -f "micro-")
if [ -n "$PIDS" ]; then
  echo $PIDS | xargs kill
fi

PIDS=$(pgrep -f "ros2")
if [ -n "$PIDS" ]; then
  echo $PIDS | xargs kill
fi

PIDS=$(pgrep -f "traj")
if [ -n "$PIDS" ]; then
  echo $PIDS | xargs kill
fi

pkill px4_interface
pkill MicroXRCEAgent
pkill ruby

