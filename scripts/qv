#!/bin/bash
if [ $PWD != $TAILSITTER_PLANNING_DIR ]
then
    echo "Please run this script in the tailsitter_planning directory"
    exit 1
fi

if [ -d "ulgs/output_csv" ]; then
    # If the directory exists and is not empty
    if [ "$(ls -A ulgs/output_csv)" ]; then
        rm ulgs/output_csv/*
    fi
fi
csv_trans
csv_plots   
