#!/usr/bin/python3

import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import argparse
import re
import os
plt.style.use('_mpl-gallery')

pattern = re.compile(r'thrust_acc_setpoint')
directory = './output_csv/'
# List all files in the directory
files = os.listdir(directory)
# csv_file_name = args.f 
csv_file_name = None
for file in files:
    if pattern.search(file) and file.endswith('.csv'):
        csv_file_name = file
        break
# Read the CSV file
df = pd.read_csv(f'{directory}{csv_file_name}', delimiter=',')

times = df['timestamp'].values
time_diff = times[1:] - times[:-1]

plt.plot(time_diff)

# print mean, max, min
print(f'Mean: {np.mean(time_diff)}')
print(f'Max: {np.max(time_diff)}')
print(f'Min: {np.min(time_diff)}')
plt.show()