#!/bin/bash
# test - Run colcon test for AP-PnC workspace

# Source environment setup (includes ROS2)
SCRIPT_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
source "$SCRIPT_DIR/.env_setup.sh"

# Get git root
GIT_ROOT="${AP_PNC_DIR:-$(cd "$SCRIPT_DIR/../.." && pwd)}"

echo -e "${AP_PNC_COLOR_BOLD}Testing AP-PnC workspace${AP_PNC_COLOR_RESET}"
echo -e "${AP_PNC_COLOR_BLUE}Workspace: ${GIT_ROOT}${AP_PNC_COLOR_RESET}"
echo

# Check if colcon is available
if ! command -v colcon &> /dev/null; then
    echo -e "${AP_PNC_COLOR_RED}Error: colcon not found. Please install ROS2 development tools.${AP_PNC_COLOR_RESET}"
    echo "  sudo apt install python3-colcon-common-extensions"
    exit 1
fi

# Parse arguments
COLCON_ARGS=()
if [ $# -eq 0 ]; then
    # Test all packages by default
    COLCON_ARGS=()
else
    # Pass through to colcon test
    COLCON_ARGS=("$@")
fi

# Run tests
echo -e "${AP_PNC_COLOR_GREEN}Running colcon test...${AP_PNC_COLOR_RESET}"
echo -e "${AP_PNC_COLOR_BLUE}colcon test ${COLCON_ARGS[*]}${AP_PNC_COLOR_RESET}"
echo

cd "$GIT_ROOT" || exit 1

colcon test "${COLCON_ARGS[@]}"

# Check test result
if [ $? -eq 0 ]; then
    echo
    echo -e "${AP_PNC_COLOR_GREEN}All tests passed ${AP_PNC_CHECKMARK}${AP_PNC_COLOR_RESET}"
else
    echo
    echo -e "${AP_PNC_COLOR_YELLOW}Some tests failed or had errors.${AP_PNC_COLOR_RESET}"
    echo -e "${AP_PNC_COLOR_BLUE}View test results with: colcon test-result --verbose${AP_PNC_COLOR_RESET}"
fi
