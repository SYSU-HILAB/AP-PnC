#! /usr/bin/bash
# streaming_ulog
OUTPUT_DIR="$PWD/artifacts/benchmarks/ulgs"
mkdir -p "$OUTPUT_DIR"
if [ -z "$1" ]; then
	echo "No argument, connects to serial port"
	mavlink_ulog_streaming.py /dev/ttyACM0 -b 921600 --output "$OUTPUT_DIR"
else
	mavlink_ulog_streaming.py 0.0.0.0:14550 --output "$OUTPUT_DIR"
fi
