#!/usr/bin/python3
import os
from pathlib import Path

import toml
import yaml


def repo_root() -> Path:
    env_root = os.getenv("AP_PNC_DIR")
    if env_root:
        return Path(env_root)
    return Path(__file__).resolve().parents[2]


def sync_circled_property(toml_file_path: Path, yaml_file_path: Path) -> None:
    """Read setup values from global.toml and sync planning node config."""
    if not toml_file_path.exists():
        raise FileNotFoundError(f"TOML config not found: {toml_file_path}")
    if not yaml_file_path.exists():
        raise FileNotFoundError(f"Planning config not found: {yaml_file_path}")

    with open(toml_file_path, "r", encoding="utf-8") as f:
        toml_data = toml.load(f)

    with open(yaml_file_path, "r", encoding="utf-8") as f:
        yaml_data = yaml.safe_load(f)

    setup = toml_data.get("setup", {})
    target = yaml_data.setdefault("/global_planning_node", {}).setdefault(
        "ros__parameters", {}
    )
    target["BasicTrajectoryRadius"] = setup.get("radius", 0.0)
    target["BasicTrajectoryType"] = setup.get("type", "")
    target["v_max"] = setup.get("v_max", 0.0)

    with open(yaml_file_path, "w", encoding="utf-8") as f:
        yaml.safe_dump(yaml_data, f, sort_keys=False)


if __name__ == "__main__":
    root = repo_root()
    toml_file_path = root / "global.toml"
    yaml_file = root / "src" / "trajectory_planner" / "trajectory_server" / "config" / "global_planning.yaml"
    sync_circled_property(toml_file_path, yaml_file)
    print(
        f"Synced planning config using '{toml_file_path.relative_to(root)}' -> "
        f"'{yaml_file.relative_to(root)}'"
    )
