#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
REPO_ROOT="${AP_PNC_DIR:-$(cd "$SCRIPT_DIR/../.." && pwd)}"

echo "Cleaning telemetry artifacts under $REPO_ROOT"

# Collect and remove *.ulg logs
mapfile -t ulg_files < <(find "$REPO_ROOT" -type f -name "*.ulg")
for file in "${ulg_files[@]}"; do
    rm -f "$file"
done

# Collect and remove rosbag directories
mapfile -t rosbag_dirs < <(find "$REPO_ROOT" -type d -name "rosbag*")
for dir in "${rosbag_dirs[@]}"; do
    rm -rf "$dir"
done

echo "Removed ${#ulg_files[@]} *.ulg files and ${#rosbag_dirs[@]} rosbag* directories."
