#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
source "$SCRIPT_DIR/.env_setup.sh"

# Sync configuration before launching
"$SCRIPT_DIR/planConfigSync"

# Launch with absolute path to avoid ros2 package lookup issues
exec ros2 launch "$AP_PNC_DIR/install/trajectory_server/share/trajectory_server/launch/planning_debug.launch.py" "$@"
