#!/bin/bash
# runall - UAV system launcher (legacy, use srunall instead)

# Source environment setup
SCRIPT_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
source "$SCRIPT_DIR/.env_setup.sh"

# Store PIDs of child processes for cleanup
PIDS=()

# Cleanup function to kill all child processes
cleanup() {
    echo -e "\n${AP_PNC_COLOR_YELLOW}Stopping all processes...${AP_PNC_COLOR_RESET}"

    # Kill all stored PIDs
    for pid in "${PIDS[@]}"; do
        if kill -0 "$pid" 2>/dev/null; then
            echo "Killing PID $pid"
            kill "$pid" 2>/dev/null
        fi
    done

    # Also kill any matching processes by name (in case PIDs weren't captured)
    pkill -f "c_nmpc" 2>/dev/null
    pkill -f "px4_interface" 2>/dev/null
    pkill -f "trajectory_server" 2>/dev/null

    # Wait for processes to terminate
    sleep 1

    # Force kill any remaining processes
    for pid in "${PIDS[@]}"; do
        if kill -0 "$pid" 2>/dev/null; then
            echo "Force killing PID $pid"
            kill -9 "$pid" 2>/dev/null
        fi
    done

    echo -e "${AP_PNC_COLOR_GREEN}All processes stopped${AP_PNC_COLOR_RESET}"
    exit 0
}

# Trap SIGINT (CTRL-C) and SIGTERM
trap cleanup SIGINT SIGTERM

# Show environment status
ap_pnc_show_env

# Sync configuration
"$SCRIPT_DIR/planConfigSync"

cores=$(nproc --all)

# 根据核心数执行不同操作
if [ "$cores" -eq 4 ]; then
    echo "Detected 4 CPU cores, distributing tasks to cores 1-3"
    taskset -c $((cores-3)) "$SCRIPT_DIR/plan" &
    PIDS+=($!)
    taskset -c $((cores-2)) "$SCRIPT_DIR/pxinterface" &
    PIDS+=($!)
    taskset -c $((cores-1)) "$SCRIPT_DIR/real_run_mpc" > /dev/null &
    PIDS+=($!)
elif [ "$cores" -eq 8 ]; then
    echo "Detected 8 CPU cores, distributing tasks to cores 5-7"
    taskset -c $((cores-3)) "$SCRIPT_DIR/plan" &
    PIDS+=($!)
    taskset -c $((cores-2)) "$SCRIPT_DIR/pxinterface" &
    PIDS+=($!)
    taskset -c $((cores-1)) "$SCRIPT_DIR/real_run_mpc" > /dev/null &
    PIDS+=($!)
elif [ "$cores" -eq 16 ]; then
    echo "Detected 16 CPU cores, distributing tasks to cores 13-15"
    taskset -c $((cores-3)) "$SCRIPT_DIR/plan" &
    PIDS+=($!)
    taskset -c $((cores-2)) "$SCRIPT_DIR/pxinterface" &
    PIDS+=($!)
    taskset -c $((cores-1)) "$SCRIPT_DIR/real_run_mpc" > /dev/null &
    PIDS+=($!)
else
    echo "CPU cores not supported, please check your CPU configuration"
    exit 1
fi

echo -e "${AP_PNC_COLOR_GREEN}All processes started. Press CTRL-C to stop.${AP_PNC_COLOR_RESET}"
echo "PIDs: ${PIDS[*]}"

# Wait for all background processes
for pid in "${PIDS[@]}"; do
    wait "$pid" 2>/dev/null
done
