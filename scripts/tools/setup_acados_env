#!/bin/bash
# setup_acados_env - Setup ACADOS environment and installation

# Source environment setup
SCRIPT_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
source "$SCRIPT_DIR/.env_setup.sh"

# Get git root
GIT_ROOT="${AP_PNC_DIR:-$(cd "$SCRIPT_DIR/../.." && pwd)}"

echo -e "${AP_PNC_COLOR_BOLD}Setting up ACADOS environment${AP_PNC_COLOR_RESET}"
echo -e "${AP_PNC_COLOR_BLUE}AP_PNC_DIR: ${GIT_ROOT}${AP_PNC_COLOR_RESET}"
echo -e "${AP_PNC_COLOR_BLUE}ACADOS_SOURCE_DIR: ${ACADOS_SOURCE_DIR}${AP_PNC_COLOR_RESET}"
echo

# Run the ACADOS installation script
INSTALL_SCRIPT="$GIT_ROOT/installations/install-acados.sh"

if [ ! -f "$INSTALL_SCRIPT" ]; then
    echo -e "${AP_PNC_COLOR_RED}Error: ACADOS installation script not found at:${AP_PNC_COLOR_RESET}"
    echo "  $INSTALL_SCRIPT"
    exit 1
fi

echo -e "${AP_PNC_COLOR_GREEN}Running ACADOS installation...${AP_PNC_COLOR_RESET}"
echo

bash "$INSTALL_SCRIPT"

# Capture exit status
INSTALL_STATUS=$?

# Check result
if [ $INSTALL_STATUS -eq 0 ]; then
    echo
    echo -e "${AP_PNC_COLOR_GREEN}ACADOS setup completed successfully ${AP_PNC_CHECKMARK}${AP_PNC_COLOR_RESET}"
    echo -e "${AP_PNC_COLOR_YELLOW}Virtual environment: ${GIT_ROOT}/.acados_venv${AP_PNC_COLOR_RESET}"
    echo -e "${AP_PNC_COLOR_YELLOW}Activate with: source ${GIT_ROOT}/.acados_venv/bin/activate${AP_PNC_COLOR_RESET}"
else
    echo
    echo -e "${AP_PNC_COLOR_RED}ACADOS setup failed. Check the output above for errors.${AP_PNC_COLOR_RESET}"
    exit 1
fi
