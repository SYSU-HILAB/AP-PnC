#!/bin/bash
# Source environment setup
SCRIPT_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
source "$SCRIPT_DIR/.env_setup.sh"

# Show environment status
ap_pnc_show_env

# Parse arguments
ZERO_COPY=true
MAX_MESSAGES=0

while [[ $# -gt 0 ]]; do
  case $1 in
    --no-zero-copy)
      ZERO_COPY=false
      shift
      ;;
    --max-messages)
      MAX_MESSAGES="$2"
      shift 2
      ;;
    -h|--help)
      echo "Usage: $0 [OPTIONS]"
      echo ""
      echo "Options:"
      echo "  --no-zero-copy     Disable zero-copy (loaned messages)"
      echo "  --max-messages N   Stop after N messages (0 = unlimited)"
      echo "  -h, --help         Show this help message"
      exit 0
      ;;
    *)
      echo "Unknown option: $1"
      exit 1
      ;;
  esac
done

# Set environment for zero-copy
export RMW_IMPLEMENTATION=rmw_fastrtps_cpp

if [ "$ZERO_COPY" = true ]; then
  export ROS_DISABLE_LOANED_MESSAGES=0
  # Get the traj_buffer package share directory - use ros2 pkg prefix
  FASTDDS_CONFIG=$(ros2 pkg prefix traj_buffer 2>/dev/null)/share/traj_buffer/fastdds.xml
  if [ ! -f "$FASTDDS_CONFIG" ]; then
    # Fallback to direct install path
    FASTDDS_CONFIG="$AP_PNC_DIR/install/traj_buffer/share/traj_buffer/fastdds.xml"
  fi

  echo "========================================"
  echo "  Zero-Copy Latency Test"
  echo "========================================"
  echo "Zero-copy: ENABLED"
  if [ -f "$FASTDDS_CONFIG" ]; then
    echo "FastDDS config: $FASTDDS_CONFIG"
    export FASTRTPS_DEFAULT_PROFILES_FILE="$FASTDDS_CONFIG"
  else
    echo "WARNING: FastDDS config not found at $FASTDDS_CONFIG"
    echo "Zero-copy may not work optimally without shared memory"
  fi
else
  export ROS_DISABLE_LOANED_MESSAGES=1
  echo "========================================"
  echo "  Normal Mode Latency Test"
  echo "========================================"
  echo "Zero-copy: DISABLED"
fi

echo "Max messages: $MAX_MESSAGES"
echo "========================================"
echo ""

# Kill any existing latency_test nodes
PIDS=$(pgrep -f "latency_test_node")
if [ -n "$PIDS" ]; then
  echo "Killing existing latency_test nodes..."
  echo $PIDS | xargs kill
  sleep 1
fi

# Launch the test
ros2 launch latency_test latency_test.launch.py max_messages:=$MAX_MESSAGES
