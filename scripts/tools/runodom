#! /usr/bin/bash
PIDS=$(pgrep -f "MicroXRCEAgent")
if [ -n "$PIDS" ]; then
  echo $PIDS | xargs kill
fi

if [ -z "$1" ]; then
  echo "Usage: $0 <device_path> <nokov_rigidbody>"
  echo "Example: $0 /dev/ttyACM0 vtolquad"
  exit 1
fi

if [ -z "$2" ]; then
  echo "Usage: $0 <device_path> <nokov_rigidbody>"
  echo "Example: $0 /dev/ttyACM0 vtolquad"
  exit 1
fi
DEVICE_PATH=$1
RIGID_BODY=$2

MicroXRCEAgent serial -b 921600 --dev $DEVICE_PATH &

if [ "$2" = "none" ]; then
  echo "No rigid body specified, skipping mocap_px4.launch.yaml"
  exit 0
fi

ros2 launch  frame_transform mocap_px4.launch.yaml rb:=$RIGID_BODY
