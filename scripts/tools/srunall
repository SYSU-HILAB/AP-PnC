#!/bin/bash
# srunall - UAV system launcher with auto-environment

# Source environment setup
SCRIPT_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
source "$SCRIPT_DIR/.env_setup.sh"

# Show environment status
ap_pnc_show_env

# Sync configuration
planConfigSync
# start px4_interface


cores=$(nproc --all)

# 根据核心数执行不同操作
if [ "$cores" -eq 4 ]; then
    echo "Detected 4 CPU cores, distributing tasks to cores 1-3"
    taskset -c $((cores-3)) ros2 launch trajectory_server planning.launch.py &
    taskset -c $((cores-2)) ros2 launch px4_interface px4_interface.launch.py &
    taskset -c $((cores-1)) real_run_mpc > /dev/null &
elif [ "$cores" -eq 8 ]; then
    echo "Detected 8 CPU cores, distributing tasks to cores 5-7"
    taskset -c $((cores-3)) ros2 launch trajectory_server planning.launch.py &
    taskset -c $((cores-2)) ros2 launch px4_interface px4_interface.launch.py &
    taskset -c $((cores-1)) real_run_mpc > /dev/null &
elif [ "$cores" -eq 16 ]; then
    echo "Detected 16 CPU cores, distributing tasks to cores 13-15"
    taskset -c $((cores-3)) ros2 launch trajectory_server planning.launch.py &
    taskset -c $((cores-2)) ros2 launch px4_interface px4_interface.launch.py &
    taskset -c $((cores-1)) real_run_mpc > /dev/null &
else
    echo "CPU cores not supported, please check your CPU configuration"
fi
