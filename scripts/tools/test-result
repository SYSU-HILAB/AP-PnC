#!/bin/bash
# test-result - View colcon test results for AP-PnC workspace

# Source environment setup (includes ROS2)
SCRIPT_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
source "$SCRIPT_DIR/.env_setup.sh"

# Get git root
GIT_ROOT="${AP_PNC_DIR:-$(cd "$SCRIPT_DIR/../.." && pwd)}"

# Run colcon test-result with any arguments passed
cd "$GIT_ROOT" || exit 1

colcon test-result "$@"
