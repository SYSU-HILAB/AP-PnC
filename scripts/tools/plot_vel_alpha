import argparse
import os
import re
from pathlib import Path

import matplotlib.pyplot as plt
import numpy as np
import pandas as pd

plt.style.use('_mpl-gallery')

# Distinctive colors
COLORS = {
    'vel_norm': '#8B0000',  # Dark red
    'alpha': '#00008B',     # Dark blue
}

# Get repo root
repo_root = Path(os.getenv('AP_PNC_DIR') or Path(__file__).resolve().parents[2])
directory = repo_root / 'artifacts' / 'simulations' / 'temp_data'


def find_latest_planning_csv(dir_path: Path) -> str | None:
    """Find the latest planning*.csv file in the directory."""
    pattern = re.compile(r'planning.*\.csv')
    files = [f for f in os.listdir(dir_path) if pattern.match(f)]

    if not files:
        return None

    files_with_time = [(f, os.path.getmtime(dir_path / f)) for f in files]
    latest_file = max(files_with_time, key=lambda x: x[1])[0]
    return latest_file


def plot_vel_alpha(csv_path: Path, show: bool = True, save: str | None = None):
    """Read planning CSV and plot vel_norm and alpha over time."""
    df = pd.read_csv(csv_path, delimiter=',')

    time = df['time'].values
    vel_x = df['vel_x'].values
    vel_y = df['vel_y'].values
    vel_z = df['vel_z'].values
    alpha = df['alpha'].values

    # Calculate velocity norm
    vel_norm = np.sqrt(vel_x**2 + vel_y**2 + vel_z**2)

    # Convert alpha to degrees
    alpha_deg = np.degrees(alpha)

    print(f"Data from: {csv_path}")
    print(f"Time range: {time[0]:.2f}s to {time[-1]:.2f}s")
    print(f"Total samples: {len(time)}")
    print(f"Velocity norm: min={vel_norm.min():.2f}, max={vel_norm.max():.2f} m/s")
    print(f"Alpha: min={alpha_deg.min():.2f}, max={alpha_deg.max():.2f} deg")

    # Create figure with 2 subplots
    fig, axes = plt.subplots(2, 1, figsize=(12, 8))

    # First subplot: velocity norm
    axes[0].plot(time, vel_norm, color=COLORS['vel_norm'], linewidth=1.5, label='|v|')
    axes[0].set_xlabel('Time [s]')
    axes[0].set_ylabel('Velocity [m/s]')
    axes[0].set_title('Velocity Norm Over Time')
    axes[0].legend()
    axes[0].grid(True)

    # Second subplot: alpha
    axes[1].plot(time, alpha_deg, color=COLORS['alpha'], linewidth=1.5, label='alpha')
    axes[1].set_xlabel('Time [s]')
    axes[1].set_ylabel('Alpha [deg]')
    axes[1].set_title('Alpha Over Time')
    axes[1].legend()
    axes[1].grid(True)

    plt.tight_layout()

    if save:
        fig.savefig(save, dpi=150, bbox_inches='tight')
        print(f"Saved plot to: {save}")

    if show:
        plt.show()

    return fig, axes


def main():
    parser = argparse.ArgumentParser(
        description='Read and plot vel_norm and alpha from the latest planning*.csv file'
    )
    parser.add_argument(
        '-f', '--file', type=str, default=None,
        help='Specific CSV file to use (default: latest planning*.csv)'
    )
    parser.add_argument(
        '-s', '--save', type=str, default=None,
        help='Save plot to file instead of showing'
    )
    parser.add_argument(
        '--no-show', action='store_true',
        help='Do not show the plot (useful with --save)'
    )

    args = parser.parse_args()

    # Determine which file to use
    if args.file:
        csv_path = Path(args.file)
    else:
        csv_file = find_latest_planning_csv(directory)
        if csv_file is None:
            print(f"No planning*.csv files found in {directory}")
            exit(1)
        csv_path = directory / csv_file

    # Plot
    plot_vel_alpha(csv_path, show=not args.no_show, save=args.save)


if __name__ == '__main__':
    main()
