#!/bin/bash
# build - Build the entire AP-PnC workspace using system Python and colcon

# Source environment setup (includes ROS2)
SCRIPT_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
source "$SCRIPT_DIR/.env_setup.sh"

# Get git root
GIT_ROOT="${AP_PNC_DIR:-$(cd "$SCRIPT_DIR/../.." && pwd)}"

echo -e "${AP_PNC_COLOR_BOLD}Building AP-PnC workspace${AP_PNC_COLOR_RESET}"
echo -e "${AP_PNC_COLOR_BLUE}Workspace: ${GIT_ROOT}${AP_PNC_COLOR_RESET}"
echo -e "${AP_PNC_COLOR_BLUE}Python: $(which python3)${AP_PNC_COLOR_RESET}"
echo

# Check if colcon is available
if ! command -v colcon &> /dev/null; then
    echo -e "${AP_PNC_COLOR_RED}Error: colcon not found. Please install ROS2 development tools.${AP_PNC_COLOR_RESET}"
    echo "  sudo apt install python3-colcon-common-extensions"
    exit 1
fi

# Clean previous build if requested
if [ "${1:-}" = "--clean" ] || [ "${1:-}" = "-c" ]; then
    echo -e "${AP_PNC_COLOR_YELLOW}Cleaning previous build...${AP_PNC_COLOR_RESET}"
    rm -rf "$GIT_ROOT/build" "$GIT_ROOT/install" "$GIT_ROOT/log"
    shift
fi

# Parse additional colcon options
COLCON_ARGS=("$@")
if [ ${#COLCON_ARGS[@]} -eq 0 ]; then
    # Build all workspace packages by default (no --packages-select)
    # This ensures dependencies are built in the correct order
    COLCON_ARGS=(--symlink-install)
fi

# Build the workspace
echo -e "${AP_PNC_COLOR_GREEN}Running colcon build...${AP_PNC_COLOR_RESET}"
echo -e "${AP_PNC_COLOR_BLUE}colcon build ${COLCON_ARGS[*]}${AP_PNC_COLOR_RESET}"
echo

cd "$GIT_ROOT" || exit 1

# Use system python3 explicitly for colcon build
colcon build "${COLCON_ARGS[@]}" \
    --cmake-args -DPYTHON_EXECUTABLE=/usr/bin/python3 -DCMAKE_BUILD_TYPE=Release

# Capture exit status immediately
BUILD_STATUS=$?

# Check build result
if [ $BUILD_STATUS -eq 0 ]; then
    echo
    echo -e "${AP_PNC_COLOR_GREEN}Build completed successfully ${AP_PNC_CHECKMARK}${AP_PNC_COLOR_RESET}"
    echo -e "${AP_PNC_COLOR_YELLOW}Source the workspace with: source install/setup.bash${AP_PNC_COLOR_RESET}"
else
    echo
    echo -e "${AP_PNC_COLOR_RED}Build failed. Check the output above for errors.${AP_PNC_COLOR_RESET}"
    exit 1
fi
