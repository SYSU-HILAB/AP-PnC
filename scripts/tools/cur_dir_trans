#!/usr/bin/env python3

import argparse
import os
import glob
import subprocess
import shutil
from pathlib import Path

def get_latest_ulg():
    """Get the latest .ulg file in the current directory."""
    ulg_files = glob.glob("*.ulg")
    if not ulg_files:
        return None
    return max(ulg_files, key=os.path.getctime)

def main():
    parser = argparse.ArgumentParser(description='Convert ULog file to CSV formats.')
    parser.add_argument('--file', '-f', type=str, help='Path to .ulg file. If not specified, uses latest .ulg in current directory.')
    args = parser.parse_args()

    # Determine which .ulg file to use
    if args.file:
        ulg_file = Path(args.file)
        if not ulg_file.is_absolute():
            ulg_file = Path.cwd() / ulg_file
    else:
        latest = get_latest_ulg()
        if not latest:
            print("No .ulg files found in current directory")
            exit(1)
        ulg_file = Path.cwd() / latest

    if not ulg_file.exists():
        print(f"File not found: {ulg_file}")
        exit(1)

    # Remove output directory if it exists and create fresh
    output_dir = Path("output_csv")
    if output_dir.exists():
        shutil.rmtree(output_dir)
    output_dir.mkdir(exist_ok=True)

    # List of message types to convert
    message_types = [
        "tracking_info",
        "vehicle_angular_velocity",
        "vehicle_rates_setpoint",
        "vehicle_thrust_acc_setpoint",
        "vehicle_acceleration",
        "vehicle_attitude",
        "vehicle_odometry"
    ]

    # Convert each message type
    for msg_type in message_types:
        subprocess.run(["ulog2csv", str(ulg_file), "-m", msg_type, "-o", str(output_dir)])

if __name__ == "__main__":
    main()
