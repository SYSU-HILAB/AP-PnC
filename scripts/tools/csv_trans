#!/usr/bin/bash

# Check if TAILSITTER_PLANNING_DIR is set
if [ -z "$TAILSITTER_PLANNING_DIR" ]; then
    echo "TAILSITTER_PLANNING_DIR is not set"
    exit 1
fi

# Get the latest .ulg file from the 'ulgs' folder
latest_ulg=$(ls -t ulgs/*.ulg | head -n 1)

# Check if we found any .ulg files
if [ -z "$latest_ulg" ]; then
    echo "No .ulg files found in ulgs/"
    exit 1
fi

# Set the output directory
FATHER_HOME="$TAILSITTER_PLANNING_DIR/ulgs"
OUTPUT_DIR="$FATHER_HOME/output_csv"

# Remove output directory if it exists and create fresh
if [ -d "$OUTPUT_DIR" ]; then
    rm -rf "$OUTPUT_DIR"
fi
mkdir -p "$OUTPUT_DIR"

# Convert .ulg to CSV using different message types
ulog2csv "$latest_ulg" -m tracking_info -o "$OUTPUT_DIR"
ulog2csv "$latest_ulg" -m vehicle_angular_velocity -o "$OUTPUT_DIR"
ulog2csv "$latest_ulg" -m vehicle_rates_setpoint -o "$OUTPUT_DIR"
ulog2csv "$latest_ulg" -m vehicle_thrust_acc_setpoint -o "$OUTPUT_DIR"
ulog2csv "$latest_ulg" -m vehicle_acceleration -o "$OUTPUT_DIR"
ulog2csv "$latest_ulg" -m vehicle_attitude -o "$OUTPUT_DIR"
ulog2csv "$latest_ulg" -m vehicle_odometry -o "$OUTPUT_DIR"
