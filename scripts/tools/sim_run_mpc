#!/bin/bash
# Source environment setup
SCRIPT_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
source "$SCRIPT_DIR/.env_setup.sh"

# Show environment status
ap_pnc_show_env

PIDS=$(pgrep -f "c_nmpc")
if [ -n "$PIDS" ]; then
  echo $PIDS | xargs kill
fi

# find if have an arugment
if [ -z "$1" ]; then
  ros2 run px4_interface offboard_mode &
fi
sleep 1

ros2 launch c_nmpc cnmpc.launch.py
