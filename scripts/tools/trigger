#!/bin/bash

# Find the workspace root (handles git worktrees)
find_workspace_root() {
    local dir=$(pwd)
    # Check for AP_PNC_DIR override
    if [ -n "$AP_PNC_DIR" ]; then
        echo "$AP_PNC_DIR"
        return
    fi

    # Try git rev-parse to find git dir
    local git_dir=$(git rev-parse --git-dir 2>/dev/null)
    if [ -n "$git_dir" ]; then
        # Check if we're in a worktree
        if [[ "$git_dir" == *"/worktrees/"* ]]; then
            # Read commondir to find original repo
            local commondir=$(cat "$git_dir/commondir" 2>/dev/null)
            if [ -n "$commondir" ]; then
                echo "$(cd "$git_dir/$commondir/.." && pwd)"
                return
            fi
        fi
        # Normal repo - parent of .git directory
        echo "$(cd "$git_dir/.." && pwd)"
        return
    fi

    # Fallback to script directory
    echo "$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
}

# Source ROS2 and workspace setup
WORKSPACE_ROOT=$(find_workspace_root)

# Source ROS2 Humble
if [ -f "/opt/ros/humble/setup.bash" ]; then
    source /opt/ros/humble/setup.bash
else
    echo "Warning: ROS2 Humble not found at /opt/ros/humble/setup.bash" >&2
fi

# Source workspace install setup
if [ -f "$WORKSPACE_ROOT/install/setup.bash" ]; then
    source "$WORKSPACE_ROOT/install/setup.bash"
else
    echo "Warning: Workspace setup not found at $WORKSPACE_ROOT/install/setup.bash" >&2
fi

if [ -z "$1" ]; then
    echo "No topic name provided. Using default '/mode'."
    topic_name="/mode"
else
    topic_name=$1
fi

# Publish a single Boolean message
ros2 topic pub $topic_name std_msgs/msg/Bool "data: true" -1
