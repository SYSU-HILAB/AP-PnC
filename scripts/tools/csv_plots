#!/usr/bin/python3

import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import argparse
import re
import os
plt.style.use('_mpl-gallery')
# get env as dir
directory = os.getenv('TAILSITTER_PLANNING_DIR')

print(directory)
def calculate_distance(ref_x, ref_y, x, y):
    return np.sqrt((ref_x - x)**2 + (ref_y - y)**2)

# parser = argparse.ArgumentParser(description='Data recording script.')

# parser.add_argument('-f', type=str, required=True, help='Name of the output CSV file')

# args = parser.parse_args()

pattern = re.compile(r'tracking_info')
directory = f'{directory}/ulgs/output_csv/'
# List all files in the directory
files = os.listdir(directory)
# csv_file_name = args.f 
csv_file_name = None
for file in files:
    if pattern.search(file) and file.endswith('.csv'):
        csv_file_name = file
        break
# Read the CSV file
df = pd.read_csv(f'{directory}{csv_file_name}', delimiter=',')
# Convert necessary columns to numpy arrays
time = df['timestamp'].values
ref_px = df['ref_position[0]'].values 
ref_py = df['ref_position[1]'].values 
px = df['actual_position[0]'].values
py = df['actual_position[1]'].values
ref_pz = df['ref_position[2]'].values
pz = df['actual_position[2]'].values

ref_vx = df['ref_velocity[0]'].values
ref_vy = df['ref_velocity[1]'].values
ref_vz = df['ref_velocity[2]'].values
vx = df['actual_velocity[0]'].values
vy = df['actual_velocity[1]'].values
vz = df['actual_velocity[2]'].values
ref_v_norm = np.sqrt(ref_vx**2 + ref_vy**2 + ref_vz**2)
time = (time - time[0]) * 1e-6
# 创建包含四个子图的图形
fig, axs = plt.subplots(2, 2, figsize=(14, 10))
# 打印 RMSE
# bool_array = ref_v_norm > 0.5
# ref_px = ref_px[bool_array]
# ref_py = ref_py[bool_array]
# px = px[bool_array]
# py = py[bool_array]
print(f'Batch RMSE XY: {np.sqrt(np.mean((calculate_distance(ref_px, ref_py, px, py))**2))}')
# 打印最大 RMSE
print(f'Batch Max RMSE: {np.max(calculate_distance(ref_px, ref_py, px, py))}')

# 第一个子图：Horizontal view: Ref_xy vs xy
axs[0, 0].plot(ref_px, ref_py, label='Ref_xy', color='green')
axs[0, 0].plot(px, py, label='xy', color='red')
axs[0, 0].set_xlabel('X Position')
axs[0, 0].set_ylabel('Y Position')
axs[0, 0].set_title('Horizontal view: Ref_xy vs xy')
axs[0, 0].legend()
axs[0, 0].grid(True)
# axs[0, 0].set_xlim([-40, 0])
# axs[0, 0].set_ylim([-20, 20])

# 第二个子图：Vertical view: Ref_z vs z
axs[0, 1].plot(time, ref_pz, label='Ref_z', color='blue')
axs[0, 1].plot(time, pz, label='z', color='red')
axs[0, 1].set_xlabel('Time')
axs[0, 1].set_ylabel('Z Position')
axs[0, 1].set_title('Vertical view: Ref_z vs z')
axs[0, 1].legend()
axs[0, 1].grid(True)


# 3rd子图：ref_vxy vs v_xy
axs[1, 1].plot(time, ref_vx, label='Ref_vx', color='blue')
axs[1, 1].plot(time, ref_vy, label='Ref_vy', color='red')
axs[1, 1].plot(time, vx, label='Vx', color='green')
axs[1, 1].plot(time, vy, label='Vy', color='red')
axs[1, 1].set_xlabel('Time')
axs[1, 1].set_ylabel('Velocity')
axs[1, 1].set_title('Ref_v_xy vs v_xy')
axs[1, 1].legend()
axs[1, 1].grid(True)

# 4th子图：Velocity Norm: Ref_v_norm vs v_norm
v_norm = np.sqrt(vx**2 + vy**2 + vz**2)
ref_v_norm = np.sqrt(ref_vx**2 + ref_vy**2 + ref_vz**2)
axs[1, 0].plot(time, ref_v_norm, label='Ref_v_norm', color='blue')
axs[1, 0].plot(time, v_norm, label='v_norm', color='red')
axs[1, 0].set_xlabel('Time')
axs[1, 0].set_ylabel('Velocity Norm')
axs[1, 0].set_title('Velocity Norm: Ref_v_norm vs v_norm')
axs[1, 0].legend()
axs[1, 0].grid(True)

# 调整子图布局
plt.tight_layout()
plt.show()


