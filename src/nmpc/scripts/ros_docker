#!/usr/bin/env python

import threading
import subprocess
import datetime
import os
import multiprocessing
import time
import argparse
import numpy as np
from utils.terminal_color import TerminalColor


def exec_command_in_specific_container(image_name):
    # 使用 docker ps 来列出正在运行的容器，并过滤指定镜像类型
    print(f"{TerminalColor.BOLD} Attempting to run container of image{image_name} {TerminalColor.ENDC}")
    user = os.environ.get('USER', '')
    command = ['docker', 'ps', '--filter', f'ancestor={image_name}', '--format', '{{.ID}}']
    container_ids = subprocess.run(command, capture_output=True, text=True).stdout.splitlines()
    if (len(container_ids) > 1):
      print(f"{TerminalColor.FAIL}There are too many containers found for image: {image_name} {TerminalColor.ENDC}")
      return
    if not container_ids:
      print(f"{TerminalColor.FAIL}No running containers found for image: {image_name}{TerminalColor.ENDC}")
      return

    # 执行命令在找到的第一个容器中
    first_container_id = container_ids[0]
    subprocess.run(['docker', 'exec', '-it','-w', f'/home/{user}', first_container_id, '/bin/bash'])

def stop_containers_by_image_name(image_name):
    # 获取特定镜像名对应的容器 ID 列表
    command = ['docker', 'ps', '--filter', f'ancestor={image_name}', '--format', '{{.ID}}']
    container_ids = subprocess.run(command, capture_output=True, text=True).stdout.splitlines()

    # 停止每个容器
    for container_id in container_ids:
        stop_command = ['docker', 'stop', container_id]
        subprocess.run(stop_command)

def remove_containers_by_image_name(image_name):
    command = ['docker', 'ps', '-a', '--filter', f'ancestor={image_name}', '--format', '{{.ID}}']
    container_ids = subprocess.run(command, capture_output=True, text=True).stdout.splitlines()

    for container_id in container_ids:
        # not use --force for safety
        remove_command = ['docker', 'rm', container_id]
        subprocess.run(remove_command)



def run_daemon_docker(image_name, real_setup = False, container_name = "sim"):
    home = os.path.expanduser("~")  # 获取用户的 HOME 目录的绝对路径
    xauthority_path = os.path.join(home, ".Xauthority")  # 构建 .Xauthority 文件的绝对路径
    display_var = os.environ.get('DISPLAY', '')
    user = os.environ.get('USER', '')
    #work wierdly, when in host mode
    # in real setup, --net=host
    if real_setup:
    # in simulation setup, --net=bridge(default)
      commands = [
          'docker', 'run', '-itd', '--network=host', f'--name={container_name}', 
          '--cpuset-cpus=2-7',
          '--privileged', '-v','/dev:/dev', '-v', f'/home/{user}/:/home/{user}', '-v', f'{xauthority_path}:/root/.Xauthority:ro',
          '--restart=always',
          '-e', f'DISPLAY={display_var}',
          image_name
      ]
    else:
      commands = [
          'docker', 'run', '-itd', '--network=host', f'--name={container_name}', 
          '--cpuset-cpus=8-15',
          '--privileged', '-v','/dev:/dev', '-v', f'/home/{user}/:/home/{user}', '-v', f'{xauthority_path}:/root/.Xauthority:ro',
          '--restart=always',
          '-e', f'DISPLAY={display_var}',
          image_name
      ]
    subprocess.run(commands)
# alias humble='docker run -itd --net=host --restart=always --device /dev/dri/ -e DISPLAY=$DISPLAY -v $HOME/.Xauthority:/root/.Xauthority:ro osrf/ros:humble-desktop

if __name__ == "__main__":
  parser = argparse.ArgumentParser(description=f'Convenient Commands for Image (Default is nmpc)')
  parser.add_argument('-e', '--exec', help='exec a docker container', action='store_true')
  parser.add_argument('--start', help='start a docker container as daemon', action='store_true')
  parser.add_argument('--stop',help='stop a docker container filtered by image_name', action='store_true')
  parser.add_argument('-rm',help='remove a docker container filtered by image_name', action='store_true')
  parser.add_argument('--real',help='real_setups', action='store_true')
  parser.add_argument('--image_name', type=str, help='image_name', default="nmpc")
  parser.add_argument('--name', type=str, help='container name', default="sim")

  args = parser.parse_args()
  image_name = args.image_name
  container_name = args.name

  # if (args.s)
  bool_array = np.array([args.start, args.stop, args.exec, args.rm]).astype(int).reshape(1,-1)
  # if (np.sum(bool_array))
  if(np.sum(bool_array, axis=1) > 1):
     print(f"{TerminalColor.FAIL}Argument nums: {np.sum(bool_array, axis=1)}, Only one argument except image_name is allowed!{TerminalColor.ENDC}")
     exit(1)
  if(np.sum(bool_array, axis=1) == 0):
     print(f"{TerminalColor.FAIL}Argument nums: {np.sum(bool_array, axis=1)}, Only one argument except image_name is allowed!{TerminalColor.ENDC}")
     exit(1)
  real_exp = args.real
  # when run, the argument real when utilize all the cpus and copy the host network to connect to mocap
  if (args.start):
    run_daemon_docker(image_name, real_setup=real_exp, container_name=container_name)
  if (args.stop):
    stop_containers_by_image_name(image_name)
  if (args.exec):
    exec_command_in_specific_container(image_name)
  if (args.rm):
     remove_containers_by_image_name(image_name)


