[submodule "src/px4_msgs/msg"]
	path = src/px4_msgs/msg
	url = https://github.com/WarriorHanamy/vtol-px4-msgs.git
	branch = main
[submodule "src/external_libraries/tomlplusplus"]
	path = src/external_libraries/tomlplusplus
	url = https://github.com/marzer/tomlplusplus.git
[submodule "src/external_libraries/yamlcpp"]
	path = src/external_libraries/yamlcpp
	url = https://github.com/jbeder/yaml-cpp.git
[submodule "mpc_framework"]
	path = mpc_framework
	url = https://github.com/acados/acados.git
[submodule "src/mocap-px4/src/mocap-ros2"]
	path = src/mocap-px4/src/mocap-ros2
	url = git@github.com:SYSU-HILAB/mocap-ros2.git
[submodule "src/external_libraries/BSplinebasis"]
	path = src/external_libraries/BSplinebasis
	url = https://github.com/WarriorHanamy/BSplinebasis.git
[submodule "scripts/sciplots"]
	path = scripts/sciplots
	url = https://github.com/WarriorHanamy/sciplots.git
[submodule "px4-vtol"]
	path = px4-vtol
	url = https://github.com/WarriorHanamy/px4-vtol.git
